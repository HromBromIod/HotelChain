{
  "HotelChainDbContext" : "Host=hotel-chain-db;Port=5432;Database=hotel_chain;Username=hotel_chain;Password=hotel_chain",
  "IdentityServer": {
    "Uri": "http://localhost:5187",
    "ClientId": "backend",
    "ClientSecret": "backend_secret",
    "ApiName": "api",
    "MasterAdminData": {
      "UserName": "MasterAdmin",
      "Password": "MasterAdmin_1234"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss:fff} {Level:u3} ({CorrelationId})] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "./logs/log-.txt",
          "rollingInterval": "Day",
          "outputTemplate": "[{Timestamp:HH:mm:ss:fff} {Level:u3} ({CorrelationId})] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
